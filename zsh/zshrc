typeset -r ZSH_DIR="${${${(%):-%x}:A}:h}"
typeset -r ZSH_MODULES=("${(@f)$(python3 - "$ZSH_DIR/config.toml" \
<<'PYTHON3'
import sys
import tomllib

with open(sys.argv[1], "rb") as f:
    data = tomllib.load(f)

modules = sorted(
    [(m["priority"], m["filename"]) for m in data["modules"]]
)

modules_set = set()
unique_modules = []

for _, module in modules:
    if module in modules_set:
        continue

    modules_set.add(module)
    unique_modules.append(module)

print("\n".join(unique_modules))
PYTHON3
)}")

typeset -r ZSH_MODULES_DIR="$ZSH_DIR/modules"

zshmods () {
    echo "$ZSH_MODULES" | tr ' ' '\n' | xargs -I {} echo -e "loaded module: {}"
}

for module in ${ZSH_MODULES[@]}; do
    source "$ZSH_MODULES_DIR/$module"
done
